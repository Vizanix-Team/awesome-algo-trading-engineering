{
  "ignorePatterns": [
    { "pattern": "^https://claude\\.ai" }
  ],
  "httpHeaders": [
    {
      "urls": ["https://github.com/", "https://raw.githubusercontent.com/"],
      "headers": {
        "Accept-Encoding": "zstd, br, gzip, deflate"
      }
    }
  ],
  "timeout": "20s",
  "retryOn429": true,
  "retryCount": 3,
  "fallbackRetryDelay": "30s",
  "aliveStatusCodes": [200, 201, 202, 203, 204, 206, 301, 302, 303, 307, 308, 403]
}
